
# ========== ステージ1: JSのビルド ==========
FROM node:24-slim AS builder
WORKDIR /frontend
COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend/ .
COPY ./templates ./templates
RUN npx vite build


# ========== ステージ2: Pythonイメージ作成 ==========
FROM python:3.13.15-slim AS python-base
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
# 実行時の uv run で環境を同期しない（依存はビルド時に入れ終わっている。同期すると起動のたびにバイトコードを作り直す）
ENV UV_NO_SYNC=1
WORKDIR /code
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock* ./
# アプリを動かすユーザー。/code と .venv は root の持ち物のままにし、アプリからは書き換えられないようにする
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app

# ========== ステージ3: サーバー用Python依存関係のインストール ==========
FROM python-base AS server-deps
RUN uv sync --frozen --no-dev


# ========== ステージ4: バッチ用Python依存関係の追加インストール ==========
FROM server-deps AS batch-deps
RUN uv sync --frozen --no-dev --extra batch

# ========== ステージ5: Server (本番用) ==========
FROM python-base AS server
COPY --from=server-deps /code/.venv /code/.venv
COPY . .
COPY --from=builder /frontend/dist ./static/dist
ENV DJANGO_SETTINGS_MODULE=config.settings.production
# collectstatic のときだけダミーの値を渡す（ENV にするとイメージに残るため）
RUN DATABASE_URL=sqlite:///dummy.db DJANGO_SECRET_KEY=dummy123 \
    uv run --frozen --no-dev manage.py collectstatic --noinput

USER app
CMD ["uv", "run", "--frozen", "--no-dev", "gunicorn", "config.wsgi:application", "--workers=1", "--threads=8", "--timeout=120"]

# ========== ステージ6: Batch (バッチジョブ用) ==========
FROM python-base AS batch
RUN apt-get update && \
    apt-get install -y postgresql-client && \
    rm -rf /var/lib/apt/lists/*
COPY --from=batch-deps /code/.venv /code/.venv
COPY . .
# LLM の出力の検証に失敗したとき、llm_client.py の save_invalid_data が outputs/ に書き込む
RUN mkdir -p outputs && chown app:app outputs
USER app
CMD ["uv", "run", "--frozen", "--no-dev", "manage.py", "help"]